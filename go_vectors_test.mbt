///|
test "Go vector consistency 4503599627370496->9007199254740992" {
  let old = @moonappend.Snapshot::new(
    4503599627370496UL,
    @moonappend.Hash32::from_hex(
      "03ade00190ec025764314bba0714185b530ae27ddeb1094a73ec1ee600d35847",
    ),
  )
  let head = @moonappend.Snapshot::new(
    9007199254740992UL,
    @moonappend.Hash32::from_hex(
      "605d4ea732fbd723c06a8cae4fa3d7cd589547993e3082c5578bce488cef3823",
    ),
  )
  let proof = @moonappend.ConsistencyProof::new(
    4503599627370496UL,
    9007199254740992UL,
    [
      @moonappend.Hash32::from_hex(
        "03ade00190ec025764314bba0714185b530ae27ddeb1094a73ec1ee600d35847",
      ),
    ],
  )
  assert_true(@moonappend.verify_consistency(old, head, proof).is_verified())
}

