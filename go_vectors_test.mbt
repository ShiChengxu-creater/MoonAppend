///|
test "Go vector inclusion size=1 index=0" {
  let head = @moonappend.Snapshot::new(
    1UL,
    @moonappend.Hash32::from_hex(
      "60972aa4e9227ea2304150151b7ffb64e30f72a992e5f32610e242eb8cdb035d",
    ),
  )
  let proof = @moonappend.InclusionProof::new(0UL, 1UL, [])
  assert_true(
    @moonappend.verify_inclusion(head, 0UL, b"\x00\xff\x2a", proof).is_verified(),
  )
  assert_false(
    @moonappend.verify_inclusion(head, 0UL, b"changed", proof).is_verified(),
  )
}

